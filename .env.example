# ==============================================================================
# Nutri-Track — Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env in development or configure these in the Vercel Dashboard
# under Settings -> Environment Variables for Production Deployment.
# NEVER commit real production secrets, tokens, or passwords to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & URL
# ------------------------------------------------------------------------------
NODE_ENV=production
# In production on Vercel, set this to your custom domain or Vercel deployment URL
# e.g., https://nutri-track.vercel.app
NEXTAUTH_URL="https://nutri-track.vercel.app"
NEXT_PUBLIC_APP_URL="https://nutri-track.vercel.app"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL — Neon, Supabase, Vercel Postgres, AWS RDS)
# ------------------------------------------------------------------------------
# Pooled connection string for serverless API routes (e.g. Neon/Supabase Pooler on port 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&pgbouncer=true"

# Optional Direct connection string for Prisma CLI migrations (Direct port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION SECURITY (NextAuth.js)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random string: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-cryptographically-secure-random-32-char-secret"

# ------------------------------------------------------------------------------
# 4. AI COACH MULTI-KEY ROTATION & RESILIENCE
# ------------------------------------------------------------------------------
# Model identifiers (default: gpt-4o-mini)
AI_MODEL="gpt-4o-mini"
AI_REASONING_MODEL="gpt-4o"
AI_BASE_URL="https://api.openai.com/v1"

# Primary & Fallback API Keys (Server-side rotation automatically falls back if rate limited)
OPENAI_API_KEY="sk-primary-openai-api-key-here"
OPENAI_API_KEY_FALLBACK_1="sk-secondary-backup-key-1"
OPENAI_API_KEY_FALLBACK_2="sk-tertiary-backup-key-2"

# ------------------------------------------------------------------------------
# 5. GOOGLE SHEETS & GOOGLE OAUTH INTEGRATION
# ------------------------------------------------------------------------------
# Master nutrition spreadsheet template URL
NEXT_PUBLIC_GOOGLE_SHEETS_TEMPLATE_URL="https://docs.google.com/spreadsheets/d/19EFB0ufPY8YHNbLp0PTwrJuFJJVz_6lz-ofau3TSxsY/edit?gid=0#gid=0"

# Google Cloud OAuth 2.0 Web Client Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Google Cloud Service Account for automated sync without user token
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_API_KEY=""

# ------------------------------------------------------------------------------
# 6. STRAVA & EXTERNAL ACTIVITY INTEGRATIONS
# ------------------------------------------------------------------------------
# Strava API Application credentials (from https://www.strava.com/settings/api)
# Set Authorization Callback Domain on Strava to your production host (e.g. nutri-track.vercel.app)
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
